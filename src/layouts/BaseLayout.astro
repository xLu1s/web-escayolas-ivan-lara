---
import { site } from '../data/site';
import { asset } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | Escayolas, pladur y aislamientos en Alcoy`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(asset('img/og-image.jpg'), Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phoneHref.replace('tel:', ''),
  image: ogImage,
  priceRange: '€€',
  founder: { '@type': 'Person', name: site.owner },
  foundingDate: `${new Date().getFullYear() - site.years}`,
  areaServed: [
    { '@type': 'City', name: 'Alcoy' },
    { '@type': 'City', name: 'Muro de Alcoy' },
    { '@type': 'City', name: 'Cocentaina' },
    { '@type': 'City', name: 'Ibi' },
    { '@type': 'AdministrativeArea', name: 'Comunidad Valenciana' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'ES',
  },
  knowsAbout: [
    'Escayolas',
    'Pladur',
    'Falsos techos',
    'Molduras',
    'Aislamiento acústico',
    'Aislamiento térmico',
  ],
  slogan: 'Presupuesto sin compromiso por teléfono',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#100d0a" />
    <meta name="author" content={site.owner} />
    <meta
      name="keywords"
      content="escayolas Alcoy, pladur Alcoy, techos de escayola Alicante, aislamiento acústico Alcoy, falsos techos Alcoy, escayolista Alcoy, Ivan Lara"
    />

    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
