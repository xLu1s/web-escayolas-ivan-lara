---
import { site, navLinks } from '../data/site';
import Icon from './Icon.astro';
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="#top" class="brand" aria-label={`${site.name} — inicio`}>
      <span class="brand__mark" aria-hidden="true">IL</span>
      <span class="brand__name">
        Escayolas Ivan Lara
        <small>Alcoy · desde {new Date().getFullYear() - site.years}</small>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Navegación principal">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={site.phoneHref} class="btn" style="margin-top:1rem;">
        <Icon name="phone" /> {site.phoneDisplay}
      </a>
    </nav>

    <div class="header__cta">
      <a href={site.phoneHref} class="btn header__phone">
        <Icon name="phone" /> {site.phoneDisplay}
      </a>
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav"
      >
        <span></span>
      </button>
    </div>
  </div>
</header>
