---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { images } from '../data/images';
import { asset } from '../utils/url';
import Icon from './Icon.astro';

const publicDir = join(process.cwd(), 'public', 'video');
const hasVideo = existsSync(join(publicDir, 'hero.mp4')) || existsSync(join(publicDir, 'hero.webm'));
const hasWebm = existsSync(join(publicDir, 'hero.webm'));
const hasMp4 = existsSync(join(publicDir, 'hero.mp4'));
---

<section class="hero" id="top">
  <div class="hero__media">
    <Image
      src={images.escayolas}
      alt="Escayolista de Ivan Lara trabajando un tabique de placa de yeso en Alcoy"
      widths={[720, 1080, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__fallback"
    />
    {hasVideo && (
      <video
        id="heroVideo"
        class="hero__video"
        poster={asset('img/hero-poster.jpg')}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        {hasWebm && <source src={asset('video/hero.webm')} type="video/webm" />}
        {hasMp4 && <source src={asset('video/hero.mp4')} type="video/mp4" />}
      </video>
    )}
    <canvas class="hero__dust" id="heroDust" aria-hidden="true"></canvas>
  </div>

  <div class="container hero__inner">
    <span class="hero__badge">
      <span class="dot"></span>
      Presupuesto sin compromiso por teléfono
    </span>

    <h1>
      Escayolas y pladur que <em>transforman</em> tu espacio
    </h1>

    <p class="hero__lead">
      Empresa familiar de Alcoy con más de {site.years} años de oficio. Techos de escayola,
      pladur, molduras y aislamientos con acabados impecables y trato directo.
    </p>

    <div class="hero__actions">
      <a href={site.phoneHref} class="btn btn--lg">
        <Icon name="phone" /> Llamar al {site.phoneDisplay}
      </a>
      <a href="#servicios" class="btn btn--lg btn--ghost">Ver servicios</a>
    </div>

    <div class="hero__meta">
      <div>
        <strong>{site.years}+</strong>
        <span>Años de experiencia</span>
      </div>
      <div>
        <strong>Alcoy</strong>
        <span>Y toda la comarca</span>
      </div>
      <div>
        <strong>Gratis</strong>
        <span>Presupuesto sin compromiso</span>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span></span>
    Desliza
  </div>
</section>

<style>
  .hero__fallback,
  .hero__video {
    position: absolute;
    inset: 0;
  }
  .hero__fallback {
    animation: heroKenburns 26s ease-in-out infinite alternate;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 1.1s ease;
    filter: saturate(1.12) contrast(1.06) brightness(1.1);
  }
  .hero__video.is-ready {
    opacity: 1;
  }
  .hero__dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.55;
    pointer-events: none;
  }

  @keyframes heroKenburns {
    from {
      transform: scale(1.06) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.18) translate3d(-2.2%, -1.6%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__fallback {
      animation: none;
    }
    .hero__dust {
      display: none;
    }
  }
</style>
