---
import { Image, getImage } from 'astro:assets';
import { images } from '../data/images';

const gallery = [
  { img: images.galTabique, alt: 'Montaje de tabiquería seca en obra' },
  { img: images.galPladur, alt: 'Colocación de placas de yeso laminado en techo' },
  { img: images.galInstalacion, alt: 'Instalación de placa de yeso en pared' },
  { img: images.galJuntas, alt: 'Tratamiento de juntas entre placas de yeso' },
  { img: images.galAtornillado, alt: 'Fijación y atornillado de placa de yeso' },
  { img: images.galPlaca, alt: 'Acabado de pared con placa lista para pintar' },
  { img: images.galTechoLijado, alt: 'Lijado de techo para un acabado liso' },
  { img: images.galAcabado, alt: 'Repaso de esquinas y acabado final' },
];

const items = await Promise.all(
  gallery.map(async (g) => {
    const full = await getImage({ src: g.img, width: 1400, format: 'webp' });
    return { ...g, full: full.src };
  })
);
---

<section class="section section--stone" id="trabajos">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Trabajos</span>
      <h2>Algunos de nuestros trabajos</h2>
      <p>
        Una muestra del día a día: reformas, techos, tabiques y aislamientos ejecutados con
        acabados cuidados.
      </p>
    </div>

    <div class="gallery__grid" data-reveal>
      {items.map((item) => (
        <button
          class="gallery__item"
          type="button"
          data-lightbox
          data-full={item.full}
          aria-label={`Ampliar imagen: ${item.alt}`}
        >
          <Image
            src={item.img}
            alt={item.alt}
            widths={[300, 500, 700]}
            sizes="(max-width: 620px) 100vw, (max-width: 1024px) 50vw, 25vw"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Imagen ampliada">
  <button class="lightbox__close" id="lightboxClose" aria-label="Cerrar">×</button>
  <img id="lightboxImg" src="" alt="" />
</div>
