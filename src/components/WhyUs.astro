---
import { commitments, site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section" id="porque">
  <div class="container why__grid">
    <div class="why__intro" data-reveal>
      <span class="eyebrow">Por qué elegirnos</span>
      <h2>Trabajos bien hechos, sin sorpresas</h2>
      <p>
        Llevamos más de {site.years} años haciendo lo mismo y hacerlo bien: escayola, pladur y
        aislamientos con acabados que aguantan el paso del tiempo. Esto es lo que nos comprometemos a
        darte en cada obra.
      </p>

      <div class="why__stat">
        <strong>{site.years}+</strong>
        <span>años de experiencia en escayola, pladur y aislamientos</span>
      </div>
    </div>

    <ul class="why__list" data-reveal style="--delay:120ms">
      {commitments.map((c) => (
        <li>
          <span class="why__ico"><Icon name={c.icon} /></span>
          <div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
