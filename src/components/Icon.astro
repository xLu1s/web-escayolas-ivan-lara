---
interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
  [key: string]: unknown;
}
const { name, class: className = '', strokeWidth = 1.8, ...rest } = Astro.props;
const stroke = strokeWidth;
---

<svg
  class={className}
  width="1em"
  height="1em"
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
  )}
  {name === 'whatsapp' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.8c2.17 0 4.21.85 5.74 2.38a8.06 8.06 0 0 1 2.38 5.73c0 4.47-3.64 8.1-8.11 8.1a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.11.82.83-3.04-.2-.31a8.05 8.05 0 0 1-1.24-4.31c0-4.47 3.64-8.1 8.14-8.1zm4.47 10.4c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.42-.55-.43h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.52.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z"
    />
  )}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'check-circle' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m8.5 12 2.5 2.5 4.5-5" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'ceiling' && (
    <>
      <path d="M3 5h18" />
      <path d="M3 9h18" />
      <path d="M7 9v4a2 2 0 0 0 2 2h0" />
      <path d="M17 9v6a2 2 0 0 1-2 2" />
      <circle cx="12" cy="17" r="2" />
    </>
  )}
  {name === 'wall' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="1.5" />
      <path d="M3 12h18M9 4v8M15 12v8" />
    </>
  )}
  {name === 'mold' && (
    <>
      <path d="M3 8h18v3a9 9 0 0 1-9 9h0a9 9 0 0 1-9-9V8z" />
      <path d="M3 8V5h18v3" />
    </>
  )}
  {name === 'sound' && (
    <>
      <path d="M4 9v6h3l5 4V5L7 9H4z" />
