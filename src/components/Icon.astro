      <path d="M9 18h6" />
      <path d="M10 21h4" />
      <path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5.9 1.2.9 1.9V16h5.2v-.2c0-.7.3-1.4.9-1.9A6 6 0 0 0 12 3z" />
    </>
  )}
  {name === 'tools' && (
    <>
      <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.1-.5-.5-2.1 2.2-2z" />
    </>
  )}
  {name === 'family' && (
    <>
      <circle cx="8" cy="8" r="2.6" />
      <circle cx="16" cy="9" r="2.2" />
      <path d="M3.5 19a4.5 4.5 0 0 1 9 0" />
      <path d="M13.5 18.4a3.6 3.6 0 0 1 7 .6" />
    </>
  )}
  {name === 'person' && (
    <>
      <circle cx="12" cy="8" r="3.4" />
      <path d="M5.5 20a6.5 6.5 0 0 1 13 0" />
    </>
  )}
  {name === 'star' && (
    <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z" />
  )}
  {name === 'broom' && (
    <>
      <path d="M14 4l6 6" />
      <path d="M13 5l6 6-3 3-6-6 3-3z" />
      <path d="M10 8 5 13l6 6 5-5" />
    </>
  )}
  {name === 'building' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="1.5" />
      <path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1" />
      <path d="M10 21v-3h4v3" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3l7 3v6c0 4.4-3 8-7 9-4-1-7-4.6-7-9V6l7-3z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {name === 'sparkle' && (
    <path d="M12 3v6m0 6v6m-3-9H3m18 0h-6m-6.4-2.4L5.2 5.2m13.6 13.6-2.4-2.4M5.2 18.8l2.4-2.4m13.6-13.6-2.4 2.4" />
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
